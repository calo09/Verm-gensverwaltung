# Verbindung zur PostgreSQL-Datenbank
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vermoegen"
# Langer Zufallswert zum Signieren der Login-Sitzung, z. B. mit: openssl rand -base64 32
SESSION_SECRET="bitte-ersetzen"
# "false" setzen, sobald dein eigenes Konto angelegt ist, damit sich niemand sonst registrieren kann
ALLOW_REGISTRATION="true"
# Schutz für den täglichen Kursabruf (/api/cron/kurse); auf Vercel wird er automatisch mitgeschickt
CRON_SECRET="bitte-ersetzen"
# Optional: kostenloser Demo-Schlüssel von coingecko.com für stabilere Krypto-Kurse
COINGECKO_API_KEY=""
